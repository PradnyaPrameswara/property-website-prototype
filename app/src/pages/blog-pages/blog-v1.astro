---
/**
 * Blog V1 — blog-pages/blog-v1.html: hero + full posts grid with
 * category links (w-dyn-list → PostsGrid).
 */
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/sections/PageHero.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";

const categories = await getCollection("categories");
---

<Base title="Blog" description="Articles and news about architecture, design, and remodeling by Archipro.">
  <PageHero title="Read our latest articles" intro="Insights, project stories, and design thinking from the Archipro studio." />
  <section class="px-6 pb-6">
    <div class="mx-auto flex max-w-[1228px] flex-wrap gap-3">
      {
        categories.map((category) => (
          <a
            href={`/blog-categories/${category.id}`}
            class="rounded-full border border-neutral-300 px-4 py-1.5 text-sm font-medium text-neutral-800 no-underline transition-colors hover:border-brand-primary hover:text-brand-primary"
          >
            {category.data.title}
          </a>
        ))
      }
    </div>
  </section>
  <section class="px-6 py-16">
    <div class="mx-auto max-w-[1228px]">
      <PostsGrid />
    </div>
  </section>
</Base>
