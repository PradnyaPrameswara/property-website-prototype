---
/** Services index — service-pages/services.html (w-dyn-list → ServicesGrid). */
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import ProcessTabs from "@/components/sections/ProcessTabs.astro";
import QuoteCta from "@/components/sections/QuoteCta.astro";
---

<Base title="Services" description="Architecture, interior design, renovation and planning services by Archipro.">
  <PageHero title="Our services" intro="From first sketch to final handover — full-scope architecture services." />
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      <ServicesGrid />
    </div>
  </section>
  <ProcessTabs />
  <QuoteCta />
</Base>
