---
/**
 * All four portfolio detail pages share the source's 934px hero layout,
 * split story/galleries, and exactly two related works.
 */
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import CircleButton from "@/components/site/CircleButton.astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("portfolio");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

const { title, description, heroImage, gallery, category, location, completed, about, execution } = project.data;

const projectOrder = [
  "house-architecture-design-in-los-angeles-ca",
  "house-architecture-design-in-los-angeles-ca-2",
  "house-architecture-design-in-los-angeles-ca-3",
  "interior-design-in-san-francisco-california",
];

const projects = await getCollection("portfolio");

const related = projectOrder.flatMap((slug) => {
  const entry = projects.find((item) => item.id === slug);

  return entry && entry.id !== project.id ? [entry] : [];
}).slice(0, 2);

const contentGallery = gallery.slice(1, 4);
---

<Base title={title} description={description} ogImage={heroImage || undefined}>
  <section class="px-6 pb-12 pt-32 sm:pt-40" aria-labelledby="portfolio-detail-title">
    <div class="mx-auto max-w-[934px]">
      <div class="mb-10 grid items-end gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,180px)]">
        <div class="min-w-0">
          <h1 id="portfolio-detail-title" class="mb-5 text-[clamp(2.5rem,4.5vw,5rem)] font-medium leading-[1.08] tracking-tightest text-neutral-800">
            {title}
          </h1>
          <p class="max-w-[426px] text-base leading-[1.6] text-neutral-600">
            Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.
          </p>
        </div>
        <div class="space-y-1 text-sm text-neutral-600 md:text-right">
          <p>{category}</p>
          <p>{location}</p>
          <p>{completed}</p>
        </div>
      </div>
      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          width="886"
          height="460"
          fetchpriority="high"
          loading="eager"
          class="aspect-[886/460] w-full rounded-3xl object-cover"
        />
      )}
    </div>
  </section>

  <section class="px-6 pb-8 pt-12 sm:pt-24" aria-labelledby="about-project">
    <div class="mx-auto max-w-[934px]">
      <div class="mx-auto max-w-[626px]">
        <h2 id="about-project" class="mb-6 text-3xl font-medium tracking-tightest text-neutral-800 sm:text-4xl">
          About the project
        </h2>
        {about.map((paragraph) => (
          <p class="mb-5 text-base leading-[1.7] text-neutral-600">{paragraph}</p>
        ))}
      </div>
      {contentGallery[0] && (
        <img
          src={contentGallery[0]}
          alt={title + " — bedroom interior"}
          width="886"
          height="460"
          loading="lazy"
          class="mt-12 aspect-[886/460] w-full rounded-3xl object-cover"
        />
      )}
    </div>
  </section>

  <section class="px-6 pb-20 pt-12 sm:pb-28" aria-labelledby="project-execution">
    <div class="mx-auto max-w-[934px]">
      <div class="mx-auto max-w-[626px]">
        <h2 id="project-execution" class="mb-6 text-3xl font-medium tracking-tightest text-neutral-800 sm:text-4xl">
          Project execution
        </h2>
        {execution.map((paragraph) => (
          <p class="mb-5 text-base leading-[1.7] text-neutral-600">{paragraph}</p>
        ))}
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {contentGallery.slice(1, 3).map((image, index) => (
          <a href={image} target="_blank" rel="noopener noreferrer" aria-label={"View " + title + " gallery image " + (index + 1)} class="group block min-w-0 overflow-hidden rounded-3xl">
            <img
              src={image}
              alt={title + " — detail image " + (index + 1)}
              width="434"
              height="460"
              loading="lazy"
              class="aspect-[434/460] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 pb-28" aria-labelledby="related-works-title">
    <div class="mx-auto max-w-[1228px]">
      <div class="mb-9 flex flex-wrap items-center justify-between gap-5">
        <h2 id="related-works-title" class="text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">Related articles</h2>
        <a href="/portfolio-pages/portfolio" class="rounded-full bg-neutral-800 px-6 py-3 text-sm font-medium text-neutral-100">Browse all projects</a>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {related.map((entry) => (
          <a href={"/portfolio/" + entry.id} class="group/card block min-w-0">
            <div class="relative mb-5 aspect-[702/364] overflow-hidden rounded-3xl bg-neutral-200">
              {entry.data.heroImage && (
                <img
                  src={entry.data.heroImage}
                  alt={entry.data.title}
                  width="702"
                  height="364"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                />
              )}
              <span class="absolute bottom-5 right-5">
                <CircleButton label={"View project: " + entry.data.title} />
              </span>
            </div>
            <h2 class="mb-2 text-2xl font-medium leading-[1.2] tracking-tightest text-neutral-800">{entry.data.title}</h2>
            <p class="text-sm text-neutral-600">{entry.data.category} · {entry.data.location}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
