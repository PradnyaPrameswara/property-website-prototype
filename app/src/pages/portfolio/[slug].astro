---
/**
 * Portfolio detail — portfolio/[slug].html (4 CMS pages). Mirrors the raw
 * layout: hero title → meta row (location/year/service/area) → hero image →
 * description → gallery → quote CTA.
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import RichText from "@/components/sections/RichText.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import PortfolioGrid from "@/components/sections/PortfolioGrid.astro";
import QuoteCta from "@/components/sections/QuoteCta.astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("portfolio");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

const { title, description, heroImage, gallery } = project.data;

const { Content } = await render(project);
---

<Base title={title} description={description} ogImage={heroImage || undefined}>
  <PageHero title={title} size="medium" />

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      {
        heroImage && (
          <img
            src={heroImage}
            alt={title}
            class="mb-12 h-[520px] w-full rounded-3xl object-cover max-lg:h-[320px]"
            loading="eager"
          />
        )
      }

      <RichText class="mx-auto mb-12 max-w-[720px]">
        <Content />
      </RichText>

      {
        gallery.length > 0 && (
          <div class="grid gap-6 md:grid-cols-2">
            {gallery.map((src, i) => (
              <img
                src={src}
                alt={`${title} — image ${i + 1}`}
                class="h-[400px] w-full rounded-3xl object-cover max-lg:h-[280px]"
                loading="lazy"
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      <SectionHeader eyebrow="More projects" title="Selected works" linkHref="/portfolio-pages/portfolio" linkLabel="All projects" />
      <PortfolioGrid limit={2} />
    </div>
  </section>

  <QuoteCta />
</Base>
