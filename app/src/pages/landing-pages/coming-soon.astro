---
/**
 * Coming soon — landing-pages/coming-soon.html. Standalone layout (the raw
 * page has no shared Header/Footer): centered wordmark, rounded photo hero
 * with heading and subscribe form, then the original footer band.
 */
import "@/styles/global.css";
import SubscribeForm from "@/components/islands/SubscribeForm";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Coming soon - Archipro</title>
    <meta name="description" content="Something new is coming from the Archipro architecture studio." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-white font-sans tracking-tightest text-neutral-800">
    <header class="flex justify-center px-6 py-6">
      <a href="/" aria-label="Archipro home">
        <img src="/assets/brand/logo-light.svg" alt="Archipro" width="144" height="32" class="h-8 w-auto" />
      </a>
    </header>

    <main class="px-4 pb-16 sm:px-6">
      <section class="relative isolate mx-auto max-w-[1440px] overflow-hidden rounded-3xl" aria-labelledby="coming-soon-title">
        <img
          src="/assets/img/688cf18185030577e478a230_modern-wooden-house-with-pool-archipro-webflow-template.jpg"
          alt="Modern wooden house with a pool"
          width="2800"
          height="1568"
          loading="eager"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="flex min-h-[520px] flex-col justify-between gap-10 p-8 sm:p-12 lg:min-h-[640px] lg:flex-row lg:items-start lg:justify-between">
          <h1 id="coming-soon-title" class="max-w-[420px] text-5xl leading-[1.08] font-medium tracking-tightest text-neutral-800 sm:text-6xl">
            Something great is taking shape
          </h1>
          <div class="w-full max-w-[402px]">
            <SubscribeForm client:visible />
          </div>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex max-w-[1228px] flex-col gap-10 px-6 pb-16 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <img src="/assets/brand/logo-light.svg" alt="Archipro" width="192" height="42" class="h-10 w-auto" />
        <p class="mt-4 text-sm leading-[1.6] text-neutral-600">
          Copyright © Archipro | Designed by<br />
          <a href="https://www.brixtemplates.com" class="font-medium text-neutral-800 hover:underline">BRIX Templates</a> · Powered by Webflow
        </p>
      </div>
      <div class="flex flex-col items-start gap-6 sm:items-end">
        <div class="w-full max-w-[402px]">
          <SubscribeForm client:visible />
        </div>
        <div class="flex items-center gap-5 text-neutral-800">
          <a href="https://www.facebook.com" aria-label="Facebook" class="text-lg font-medium">f</a>
          <a href="https://www.instagram.com" aria-label="Instagram" class="text-lg font-medium">◎</a>
          <a href="https://www.linkedin.com" aria-label="LinkedIn" class="text-lg font-medium">in</a>
          <a href="https://www.pinterest.com" aria-label="Pinterest" class="text-lg font-medium">p</a>
        </div>
      </div>
    </footer>
  </body>
</html>
