---
/**
 * Blog category detail — blog-categories/[slug].html (3 CMS pages):
 * hero + posts filtered by category (guide Phase 4 step 4).
 */
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/sections/PageHero.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";

export const getStaticPaths = (async () => {
  const categories = await getCollection("categories");

  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category },
  }));
}) satisfies GetStaticPaths;

const { category } = Astro.props;

const { title, description } = category.data;
---

<Base title={`${title} articles`} description={description}>
  <PageHero title={title} intro={description} />
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      <PostsGrid category={title} />
    </div>
  </section>
</Base>
