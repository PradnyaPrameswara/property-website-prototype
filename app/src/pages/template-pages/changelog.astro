---
/** Source-matched version history: template-pages/changelog.html. */
import Base from "@/layouts/Base.astro";
---

<Base title="Changelog" description="Version history of the Archipro template.">
  <section class="px-6 pb-24 pt-32 sm:pt-40">
    <div class="mx-auto max-w-[860px]">
      <h1 class="mb-5 text-5xl font-medium tracking-tightest text-neutral-800 sm:text-6xl">Changelog</h1>
      <p class="mb-10 max-w-[550px] text-base leading-[1.6] text-neutral-600">Follow this page to keep updated with the latest template changes.</p>
      <div class="rounded-3xl bg-brand-secondary-200 px-7 py-9 sm:px-10">
        <div class="mb-5 flex flex-wrap items-center gap-5">
          <time datetime="2025-12-26" class="text-sm text-neutral-600">December 26, 2025</time>
          <span class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-800">1.0</span>
        </div>
        <h2 class="mb-3 text-3xl font-medium tracking-tightest text-neutral-800">Template release</h2>
        <p class="text-base leading-[1.6] text-neutral-600">Initial Archipro Webflow Ecommerce Template Release</p>
      </div>
    </div>
  </section>
</Base>
