---
/**
 * Service detail — services/[slug].html (15 CMS pages, static via
 * getStaticPaths — guide Phase 4 step 4).
 */
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import QuoteCta from "@/components/sections/QuoteCta.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";

export const getStaticPaths = (async () => {
  const services = await getCollection("services");

  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;

const { title, excerpt, image } = service.data;
---

<Base title={title} description={excerpt} ogImage={image || undefined}>
  <PageHero title={title} intro={excerpt} size="medium" />

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      {
        image && (
          <img
            src={image}
            alt={title}
            class="mb-12 h-[480px] w-full rounded-3xl object-cover max-lg:h-[320px]"
            loading="eager"
          />
        )
      }
      <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
        <div class="prose max-w-none text-lg leading-[1.6em] text-neutral-600">
          <p>{excerpt}</p>
        </div>
        <aside class="h-fit rounded-3xl bg-neutral-200 p-8">
          <h2 class="mb-4 text-xl font-medium tracking-tightest text-neutral-800">Start your project</h2>
          <p class="mb-6 text-base leading-[1.5em] text-neutral-600">
            Tell us about your project and we’ll get back with a tailored proposal.
          </p>
          <a
            href="/landing-pages/request-a-quote"
            class="inline-flex items-center rounded-full bg-neutral-800 px-6 py-3 text-sm font-medium text-neutral-100 transition-colors hover:bg-brand-primary"
          >
            Request a quote
          </a>
        </aside>
      </div>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      <SectionHeader eyebrow="More services" title="Explore more services" linkHref="/service-pages/services" linkLabel="All services" />
      <ServicesGrid limit={3} />
    </div>
  </section>

  <QuoteCta />
</Base>
