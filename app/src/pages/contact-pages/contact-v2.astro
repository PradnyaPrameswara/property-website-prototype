---
/**
 * Contact V2 — contact-pages/contact-v2.html: centered hero,
 * full-width form card, then office info row.
 */
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/islands/ContactForm";
import FaqAccordion from "@/components/islands/FaqAccordion";

const faqs = [
  {
    question: "How do we start a project together?",
    answer: "Send us a message with your project scope — we’ll schedule an intro call within one business day.",
  },
  {
    question: "Do you work outside San Francisco?",
    answer: "Yes — we deliver residential and commercial projects worldwide, with local partners on site.",
  },
  {
    question: "What information should I include?",
    answer: "Location, approximate size, budget range, and timeline help us give you an accurate first estimate.",
  },
];
---

<Base title="Contact V2" description="Get in touch with the Archipro architecture studio.">
  <section class="px-6 pt-40 pb-16 text-center max-lg:pt-32">
    <div class="mx-auto max-w-[1228px]">
      <h1 class="mx-auto max-w-[16ch] text-6xl leading-[1.05em] font-medium tracking-tightest text-neutral-800 max-lg:text-5xl">
        Let’s talk about your project
      </h1>
      <p class="mx-auto mt-6 max-w-[52ch] text-lg leading-[1.5em] text-neutral-600">
        Tell us about your project — we usually reply within one business day.
      </p>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[860px] rounded-3xl bg-neutral-200 p-8 max-lg:p-6">
      <ContactForm client:visible />
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[860px]">
      <h2 class="mb-8 text-4xl leading-[1.15em] font-medium tracking-tightest text-neutral-800 max-lg:text-3xl">
        Frequently asked questions
      </h2>
      <FaqAccordion client:visible items={faqs} />
    </div>
  </section>
</Base>
