---
/**
 * Team member detail rebuilt against team/[slug].html.
 * Source hero contains the portrait and "About me" copy; articles follow.
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import RichText from "@/components/sections/RichText.astro";
import PostCard from "@/components/site/cards/PostCard.astro";

export const getStaticPaths = (async () => {
  const members = await getCollection("team");

  return members.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}) satisfies GetStaticPaths;

const { member } = Astro.props;

const { name, role, bio, photo } = member.data;

const { Content } = await render(member);

const articleSource = new Map(Object.entries({
  "andy-smith": [{ slug: "clever-diy-home-improvements-you-can-easily-do-anytime", image: "6883f8e69ddb3ed27658de9d_easy-diy-home-improvements-2-1-archipro-webflow-template.jpg" }],
  "john-carter": [{ slug: "12-design-tricks-for-picking-the-perfect-home-color-palette", image: "6883f94e796d145654776ac1_12-tricks-perfect-color-palette-2-1-archipro-webflow-template.jpg" }, { slug: "25-color-trends-designers-cant-wait-to-see-in-2026", image: "6883f917e707caf6ffe02ac7_top-25-color-trends-2026-2-1-archipro-webflow-template.jpg" }],
  "lilly-woods": [{ slug: "how-to-give-maintenance-to-your-wooden-furniture-the-full-guide", image: "6883f893969d9194e90eb00c_wood-furniture-care-guide-2-1-archipro-webflow-template.jpg" }],
  "matt-cannon": [],
  "maya-collins": [{ slug: "15-mind-blowing-floor-designs-to-make-your-home-look-great", image: "6883f8bb9e957b590f3c3da3_15-stunning-floor-designs-2-1-archipro-webflow-template.jpg" }],
  "patrick-meyer": [],
  "sandy-houston": [],
  "sophie-moore": [{ slug: "front-door-design-ideas-6-great-concepts-for-your-home", image: "6883f7a04928dd9615ba2bba_6-front-door-design-ideas-2-1-archipro-webflow-template.jpg" }, { slug: "front-door-design-ideas-6-great-concepts-for-your-home-copy", image: "6883f7a04928dd9615ba2bba_6-front-door-design-ideas-2-1-archipro-webflow-template.jpg" }],
} satisfies Record<string, { slug: string; image: string }[]>));

const allPosts = await getCollection("posts");

const authoredPosts = (articleSource.get(member.id) ?? []).flatMap(({ slug, image }) => {
  const post = allPosts.find((entry) => entry.id === slug);

  return post ? [{ post, image }] : [];
});

const display = (date: Date) => date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Base title={name} description={bio ?? "About " + name + ", " + (role ?? "team member") + " at Archipro"} ogImage={photo || undefined}>
  <section class="px-6 pt-36 pb-24 max-md:pt-28">
    <div class="mx-auto grid max-w-[1228px] items-start justify-between gap-10 lg:grid-cols-[minmax(0,490px)_minmax(0,564px)] lg:gap-16">
      {photo ? (
        <img
          src={photo}
          alt={"Portrait of " + name}
          width="490"
          height="512"
          loading="eager"
          class="aspect-[490/512] w-full rounded-3xl object-cover"
        />
      ) : (
        <div class="aspect-[490/512] w-full rounded-3xl bg-neutral-200" role="img" aria-label={"Portrait of " + name} />
      )}
      <div>
        <h1 class="mb-6 text-5xl font-medium leading-[1.08] tracking-tightest text-neutral-800 max-lg:text-4xl">About me</h1>
        <RichText class="max-w-[564px]">
          <Content />
        </RichText>
      </div>
    </div>
  </section>

  <section class="px-6 pb-24" aria-labelledby="team-articles-heading">
    <div class="mx-auto max-w-[1228px]">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <h2 id="team-articles-heading" class="mb-3 text-3xl font-medium tracking-tightest text-neutral-800 sm:text-4xl">Articles by</h2>
          <p class="text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">{name}</p>
        </div>
        <a href="/blog-pages/blog-v1" class="rounded-full bg-neutral-800 px-6 py-3 text-sm font-medium text-neutral-100">Browse all articles</a>
      </div>
      {authoredPosts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {authoredPosts.map(({ post, image }) => (
            <PostCard
              href={"/blog-posts/" + post.id}
              title={post.data.title}
              category={post.data.category}
              date={display(post.data.date)}
              imageSrc={"/assets/img/" + image}
              imageAlt={post.data.title}
            />
          ))}
        </div>
      ) : (
        <p class="rounded-2xl bg-neutral-200 px-6 py-7 text-neutral-600">No items found.</p>
      )}
    </div>
  </section>
</Base>
