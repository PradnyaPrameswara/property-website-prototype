---
/** Portfolio index — portfolio-pages/portfolio.html (w-dyn-list → PortfolioGrid). */
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/sections/PageHero.astro";
import PortfolioGrid from "@/components/sections/PortfolioGrid.astro";
import QuoteCta from "@/components/sections/QuoteCta.astro";
---

<Base title="Portfolio" description="Selected architecture and interior design works by Archipro.">
  <PageHero title="Selected works" intro="A selection of residential and commercial projects designed by our studio." />
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-[1228px]">
      <PortfolioGrid />
    </div>
  </section>
  <QuoteCta />
</Base>
