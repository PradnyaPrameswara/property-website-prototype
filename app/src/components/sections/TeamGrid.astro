---
/**
 * TeamGrid — team collection grid (replaces w-dyn-list).
 */
import { getCollection } from "astro:content";
import TeamCard from "@/components/site/cards/TeamCard.astro";

interface Props {
  limit?: number;
  order?: string[];
}

const { limit, order } = Astro.props;

const all = await getCollection("team");

const ranked = order
  ? [...all].sort((a, b) => {
      const position = (id: string) => {
        const index = order.indexOf(id);

        return index === -1 ? Number.POSITIVE_INFINITY : index;
      };

      return position(a.id) - position(b.id);
    })
  : all;

const members = limit ? ranked.slice(0, limit) : ranked;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    members.map((member) => (
      <TeamCard
        href={`/team/${member.id}`}
        name={member.data.name}
        role={member.data.role ?? ""}
        photoSrc={member.data.photo || undefined}
      />
    ))
  }
</div>
