---
/**
 * TeamGrid — team collection grid (replaces w-dyn-list).
 */
import { getCollection } from "astro:content";
import TeamCard from "@/components/site/cards/TeamCard.astro";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const all = await getCollection("team");

const members = limit ? all.slice(0, limit) : all;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    members.map((member) => (
      <TeamCard
        href={`/team/${member.id}`}
        name={member.data.name}
        role={member.data.role ?? ""}
        photoSrc={member.data.photo || undefined}
      />
    ))
  }
</div>
