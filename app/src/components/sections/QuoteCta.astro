---
/**
 * QuoteCta — "Let's work together. Get a quote today." CTA band
 * (appears on all three home pages) → links to request-a-quote.
 */
import SiteButton from "@/components/site/SiteButton.astro";
---

<section class="px-6 py-24">
  <div class="mx-auto flex max-w-[1228px] flex-col items-center gap-8 rounded-3xl bg-brand-secondary-200 px-8 py-20 text-center">
    <h2 class="max-w-[20ch] text-4xl leading-[1.15em] font-medium tracking-tightest text-neutral-800 max-lg:text-3xl">
      Let’s work together. Get a quote today.
    </h2>
    <SiteButton href="/landing-pages/request-a-quote" label="Request a quote" />
  </div>
</section>
