---
/**
 * Pagination — Webflow `.w-pagination-wrapper` prev/next (guide 2.17).
 * Source: reference/components/pagination.html
 * Static links generated by Astro `paginate()` — no client JS.
 */
interface Props {
  prevUrl?: string;
  nextUrl?: string;
  class?: string;
}

const { prevUrl, nextUrl, class: className } = Astro.props;
---

<nav
  aria-label="Pagination"
  class:list={["flex items-center justify-between gap-4", className]}
>
  {
    prevUrl ? (
      <a href={prevUrl} class="group/btn inline-flex items-center gap-1.5 rounded-full border border-neutral-800 px-6 py-2.5 text-base font-medium text-neutral-800 no-underline transition-transform duration-300 hover:scale-[0.98]">
        ← Previous
      </a>
    ) : (
      <span />
    )
  }
  {
    nextUrl && (
      <a href={nextUrl} class="group/btn inline-flex items-center gap-1.5 rounded-full border border-neutral-800 px-6 py-2.5 text-base font-medium text-neutral-800 no-underline transition-transform duration-300 hover:scale-[0.98]">
        Next →
      </a>
    )
  }
</nav>
