---
/**
 * SiteButton — Webflow `.primary-button` (pill, dot + sliding arrow on hover).
 * Source: reference/components/button-primary.html
 * Exact source values: padding 12px 32px, gap 6px, radius 100px,
 * bg primary #f6694b, text neutral-100, 16px / 1.25 / 500,
 * shadow 0 4px 8px #4d91e11a, hover scale(0.98).
 * The IX2 hover (dot shrinks, arrow slides in from the left, text shifts
 * right) is reproduced with pure CSS group-hover transitions.
 */
import { ArrowUpRight } from "lucide-react";

interface Props {
  href: string;
  label: string;
  /** light = dark sections (white bg, dark text); small = compact size */
  variant?: "default" | "light" | "small";
  class?: string;
}

const { href, label, variant = "default", class: className } = Astro.props;

const isLight = variant === "light";

const isSmall = variant === "small";
---

<a
  href={href}
  class:list={[
    "group/btn inline-flex items-center justify-center gap-1.5 rounded-full border text-center font-medium leading-[1.25em] no-underline transition-transform duration-300 hover:scale-[0.98]",
    isSmall ? "px-4 py-2 text-sm" : "px-8 py-3 text-base",
    isLight
      ? "border-neutral-100 bg-neutral-100 text-neutral-800"
      : "border-brand-primary bg-brand-primary text-neutral-100 shadow-[0_4px_8px_#4d91e11a]",
    className,
  ]}
>
  <span class="flex items-center gap-1.5 overflow-hidden">
    {/* Dot: visible by default, shrinks away on hover */}
    <span
      aria-hidden="true"
      class:list={[
        "size-3 min-h-3 min-w-3 rounded-full transition-all duration-300 group-hover/btn:w-0 group-hover/btn:min-w-0 group-hover/btn:scale-0 group-hover/btn:opacity-0",
        isLight ? "bg-neutral-800" : "bg-neutral-100",
      ]}
    ></span>
    {/* Arrow: parked 16px left + transparent, slides in on hover */}
    <ArrowUpRight
      aria-hidden="true"
      className="-ml-4 size-4 -translate-x-2 opacity-0 transition-all duration-300 group-hover/btn:translate-x-0 group-hover/btn:opacity-100"
    />
    <span class="-translate-x-2 transition-transform duration-300 group-hover/btn:translate-x-0">
      {label}
    </span>
  </span>
</a>
