---
/**
 * TeamCard — team grid card (guide 2.7).
 * Photo (zoom on hover), name, role, social links row.
 */
import SocialIcon from "@/components/site/SocialIcon.astro";

interface Props {
  href: string;
  name: string;
  role: string;
  photoSrc?: string;
  socials?: { label: string; href: string }[];
  class?: string;
}

const { href, name, role, photoSrc, socials = [], class: className } = Astro.props;
---

<div class:list={["group/card", className]}>
  <a href={href} class="block no-underline">
    <div class="mb-5 h-[380px] overflow-hidden rounded-3xl max-lg:h-[300px]">
      {
        photoSrc ? (
          <img
            src={photoSrc}
            alt={name}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105"
          />
        ) : (
          <div class="h-full w-full bg-neutral-300 transition-transform duration-500 group-hover/card:scale-105" role="img" aria-label={name} />
        )
      }
    </div>
    <h3 class="mb-1 text-2xl leading-[1.25em] font-medium tracking-tightest text-neutral-800">{name}</h3>
    <p class="text-base text-neutral-600">{role}</p>
  </a>
  {
    socials.length > 0 && (
      <ul class="mt-3 flex list-none gap-2 p-0">
        {socials.map((s) => {
          const iconName = s.label.toLowerCase();
          const isKnown = ["facebook", "instagram", "linkedin", "pinterest"].includes(iconName);
          return (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${name} on ${s.label}`}
                class="flex size-9 items-center justify-center rounded-full border border-neutral-300 text-neutral-800 no-underline transition-colors duration-300 hover:border-brand-primary hover:text-brand-primary"
              >
                {isKnown ? (
                  <SocialIcon name={iconName as "facebook" | "instagram" | "linkedin" | "pinterest"} class="size-4" />
                ) : (
                  s.label.slice(0, 1)
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</div>
