---
/**
 * TestimonialCard — quote card used in sliders/marquees (guide 2.7).
 * Source classes: .marquee---testimonial-card (max-width 345px).
 */
interface Props {
  quote: string;
  author: string;
  role?: string;
  avatarSrc?: string;
  class?: string;
}

const { quote, author, role, avatarSrc, class: className } = Astro.props;
---

<figure
  class:list={[
    "m-0 flex max-w-[345px] flex-col gap-5 rounded-3xl bg-neutral-100 p-8 shadow-[0_1px_3px_#19213d1a]",
    className,
  ]}
>
  <blockquote class="m-0 text-lg leading-[1.5em] text-neutral-800">“{quote}”</blockquote>
  <figcaption class="flex items-center gap-3">
    {
      avatarSrc ? (
        <img src={avatarSrc} alt="" loading="lazy" class="size-11 rounded-full object-cover" />
      ) : (
        <span aria-hidden="true" class="size-11 rounded-full bg-neutral-300" />
      )
    }
    <span>
      <span class="block text-base font-medium text-neutral-800">{author}</span>
      {role && <span class="block text-sm text-neutral-600">{role}</span>}
    </span>
  </figcaption>
</figure>
