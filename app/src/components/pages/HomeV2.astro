---
/**
 * HomeV2 composition — mirrors home-pages/home-v2.html section order:
 * hero (split layout) → Inside the firm → Selected works →
 * From concept to completion → quote CTA → process tabs →
 * testimonials ("Trusted by 10k+ happy clients worldwide") → latest articles.
 */
import SiteButton from "@/components/site/SiteButton.astro";
import Slider from "@/components/site/Slider.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";
import HomeV2Testimonials from "@/components/sections/HomeV2Testimonials.astro";
import ProcessTabs from "@/components/sections/ProcessTabs.astro";


const capsules = [
  { src: "/assets/img/688a8f736ba3faadf02781f4_minimalist-bedroom-hero-archipro-webflow-template.png", alt: "Minimalist bedroom", offset: "mt-[68px]" },
  { src: "/assets/img/688a8f73c7632f2e0ff7b0b3_modern-living-room-hero-archipro-webflow-template.png", alt: "Modern living room", offset: "mt-0" },
  { src: "/assets/img/688a8f734866d06a9c67bd1d_wooden-dining-table-hero-archipro-webflow-template.png", alt: "Wooden dining table", offset: "mt-[125px]" },
  { src: "/assets/img/688a8f7371c3c0dcf19aa5a7_minimalist-bathroom-hero-archipro-webflow-template.png", alt: "Minimalist bathroom", offset: "mt-[66px]" },
];

const studioImage = "/assets/img/688a93b259161daf15717fec_cozy-seating-area-archipro-webflow-template.png";

const selectedProjects = [
  { slug: "house-architecture-design-in-los-angeles-ca", title: "House architecture design in Los Angeles, CA", image: "69320cff5d1a2607af7c41d7_house-architecture-design-v1-featured-image-archipro-webflow-template.jpg" },
  { slug: "house-architecture-design-in-los-angeles-ca-2", title: "House architecture design in Los Angeles, CA", image: "69320d1b06f609b186057063_house-architecture-design-v2-featured-image-archipro-webflow-template.jpg" },
];

const sourceServices = [
  { title: "Exterior design", image: "688a9eec0d0ee3ae45ae0fee_exterior-design-default-archipro-webflow-template.png" },
  { title: "Decoration", image: "688a9eec7e977e290017bd94_decoration-default-archipro-webflow-template.png" },
  { title: "Construction", image: "688a9eec66950241e75c1b2c_construction-default-archipro-webflow-template.png" },
  { title: "Interior design", image: "688a9eec9cc56e22f468af13_interior-design-default-archipro-webflow-template.png" },
];

const serviceIntro = "Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.";
---

{/* Original Home V2 hero: four staggered image capsules beside the introduction. */}
<section class="px-6 pt-28 pb-20 sm:pt-40 lg:pb-28">
  <div class="mx-auto grid max-w-[1228px] items-center gap-10 lg:grid-cols-[1.7fr_1fr] lg:gap-16">
    <div class="order-2 grid grid-cols-4 items-start gap-2 overflow-hidden sm:gap-4 lg:order-1" aria-label="Four featured interior spaces">
      {capsules.map((capsule) => (
        <div class:list={["min-w-0 overflow-hidden rounded-full bg-neutral-200", capsule.offset]}>
          <img
            src={capsule.src}
            alt={capsule.alt}
            width="360"
            height="900"
            loading="eager"
            class="aspect-[2/5] w-full object-cover"
          />
        </div>
      ))}
    </div>
    <div class="order-1 lg:order-2">
      <h1 class="text-[clamp(2rem,4vw,4.6rem)] leading-[1.08] font-medium tracking-tightest text-neutral-800">
        Crafting spaces with purpose and personality
      </h1>
      <p class="mt-3 max-w-[392px] text-lg leading-[1.55] text-neutral-600">
        Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse adipiscing cras nec.
      </p>
      <div class="mt-5">
        <SiteButton href="/contact-pages/contact-v1" label="Get in touch" />
      </div>
    </div>
  </div>
</section>

<section class="overflow-hidden rounded-3xl bg-brand-secondary-200 pt-24">
  <div class="mx-auto grid max-w-[1228px] items-start gap-8 px-6 pb-12 lg:grid-cols-[1fr_1fr_auto]">
    <h2 class="text-4xl leading-[1.08] font-medium tracking-tightest text-neutral-800 sm:text-5xl">Inside the firm</h2>
    <p class="max-w-[430px] text-lg leading-[1.55] text-neutral-600">
      The way we live, work, and connect keeps changing—and so should the spaces around us.
      At Archipro, we design adaptable, thoughtful environments that grow with you.
      Easy to shape, a pleasure to be in, and made to bring out the best in people.
      Because great spaces don’t just look good—they make life better.
    </p>
    <SiteButton href="/contact-pages/contact-v1" label="Get in touch" />
  </div>
  <img
    src={studioImage}
    alt="Warmly furnished studio seating area"
    width="1680"
    height="485"
    loading="lazy"
    class="mx-auto w-full max-w-[1680px] object-cover"
  />
</section>

{/* Source Home V2 contains exactly two full-width featured project rows. */}
<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <div class="mx-auto mb-12 max-w-[426px] text-center">
      <h2 class="mb-4 text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">Selected works</h2>
      <p class="leading-[1.6] text-neutral-600">{serviceIntro}</p>
    </div>
    <div class="divide-y divide-neutral-300">
      {selectedProjects.map((project) => (
        <a href={"/portfolio/" + project.slug} class="group grid min-w-0 items-center gap-8 py-9 first:pt-0 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
          <div class="flex h-full flex-col justify-between gap-6">
            <div>
              <h3 class="mb-4 text-3xl font-medium leading-[1.15] tracking-tightest text-neutral-800 sm:text-4xl">{project.title}</h3>
              <p class="text-sm leading-[1.5] text-neutral-600">Architecture · Los Angeles, CA</p>
            </div>
            <p class="max-w-[420px] leading-[1.6] text-neutral-600">{serviceIntro}</p>
          </div>
          <div class="aspect-[702/364] min-w-0 overflow-hidden rounded-3xl bg-neutral-200">
            <img src={"/assets/img/" + project.image} alt={project.title} width="702" height="364" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

{/* Source Home V2 services: four photographed slider cards, not the generic six-card list. */}
<section class="overflow-hidden px-6 py-24">
  <div class="mx-auto grid max-w-[1228px] items-start gap-8 lg:grid-cols-[minmax(0,0.38fr)_minmax(0,1fr)] lg:gap-14">
    <div>
      <h2 class="mb-5 text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">From concept to completion</h2>
      <p class="mb-7 max-w-[420px] leading-[1.6] text-neutral-600">{serviceIntro}</p>
      <SiteButton href="/service-pages/services" label="Browse all services" />
    </div>
    <Slider label="Browse architecture design services">
      {sourceServices.map((service) => (
        <a href="/service-pages/services" class="group block w-[min(82vw,448px)] shrink-0 snap-start overflow-hidden rounded-3xl bg-brand-secondary-200 text-neutral-800 no-underline">
          <img src={"/assets/img/" + service.image} alt={service.title} width="448" height="624" loading="lazy" class="aspect-[448/624] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
          <div class="p-6">
            <h3 class="mb-3 text-2xl font-medium tracking-tightest">{service.title}</h3>
            <p class="leading-[1.55] text-neutral-600">{serviceIntro}</p>
          </div>
        </a>
      ))}
    </Slider>
  </div>
</section>

{/* Original Home V2 background-photo CTA instead of a blank solid-color card. */}
<section class="relative isolate overflow-hidden bg-neutral-800 px-6 py-28 sm:py-36" aria-labelledby="home-v2-quote">
  <img
    src="/assets/img/688aa7b404595ae5e675ddd1_modern-living-room-with-neutral-furniture-archipro-webflow-template.jpg"
    alt=""
    width="2800"
    height="1340"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div aria-hidden="true" class="absolute inset-0 bg-neutral-800/55"></div>
  <div class="relative z-10 mx-auto max-w-[1228px] text-center">
    <div class="mx-auto max-w-[430px]">
      <h2 id="home-v2-quote" class="mb-5 text-4xl font-medium leading-[1.1] tracking-tightest text-neutral-100 sm:text-5xl">Let’s work together. Get a quote today.</h2>
      <p class="mb-7 leading-[1.6] text-neutral-200">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.</p>
      <div class="flex justify-center">
        <SiteButton href="/contact-pages/contact-v1" label="Get in touch" variant="light" />
      </div>
    </div>
  </div>
</section>

<ProcessTabs />
<HomeV2Testimonials />

<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader eyebrow="Blog" title="Read our latest articles" linkHref="/blog-pages/blog-v2" linkLabel="All articles" />
    <PostsGrid limit={3} />
  </div>
</section>
