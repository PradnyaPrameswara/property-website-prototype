---
/**
 * HomeV3 composition — mirrors home-pages/home-v3.html section order:
 * background-video hero → From concept to completion → Tour our office
 * (lightbox) → process tabs → quote CTA → testimonials → Follow our work
 * (marquee) → latest articles.
 * Hero video + office-tour lightbox localized in Phase 5 (/assets/video/).
 */
import Marquee from "@/components/site/Marquee.astro";
import SubscribeForm from "@/components/islands/SubscribeForm";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";
import QuoteCta from "@/components/sections/QuoteCta.astro";
import ProcessTabs from "@/components/sections/ProcessTabs.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import Lightbox from "@/components/islands/Lightbox";
import { iconMap } from "@/lib/icons";

const PlayIcon = iconMap.play;

const followImages = [
  "/assets/img/69320d6778b1408e9a62b501_interior-design-in-san-francisco-featured-image-archipro-webflow-template.jpg",
  "/assets/img/69320cff5d1a2607af7c41d7_house-architecture-design-v1-featured-image-archipro-webflow-template.jpg",
  "/assets/img/6883fec1daafa038da7629de_modern-bedroom-with-large-window-archipro-webflow-template-archipro-webflow-template.jpg",
  "/assets/img/6883ff2cefd36f2ec72221d9_cozy-modern-living-room-archipro-webflow-template-archipro-webflow-template.jpg",
];
---

{/* Original Home V3: photographic card with responsive email CTA. */}
<section class="relative isolate mx-4 mt-4 min-h-[426px] overflow-hidden rounded-3xl bg-neutral-800 sm:mx-6 sm:min-h-[600px] lg:min-h-[770px]">
  <img
    src="/assets/img/688b9d50b83ea2f28adb8d92_modern-mountain-house-archipro-webflow-template.jpg"
    alt="Modern mountain house with exterior deck"
    width="2800"
    height="1576"
    fetchpriority="high"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-neutral-800/35 via-neutral-800/10 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex min-h-[426px] max-w-[1228px] items-end px-5 pb-10 pt-36 sm:min-h-[600px] sm:px-10 lg:min-h-[770px] lg:pb-32">
    <div class="w-full max-w-[626px]">
      <h1 class="max-w-[16ch] text-[clamp(2rem,3.8vw,4.8rem)] lg:max-w-[22ch] lg:text-[clamp(2rem,3.5vw,3.8rem)] leading-[1.08] font-medium tracking-tightest text-neutral-100">
        Crafting spaces with purpose and personality
      </h1>
      <div class="mt-5 max-w-[402px]">
        <SubscribeForm client:load variant="hero" />
      </div>
    </div>
  </div>
</section>

<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader eyebrow="Services" title="From concept to completion" linkHref="/service-pages/services" linkLabel="All services" />
    <ServicesGrid limit={6} />
  </div>
</section>

{/* Tour our office — video lightbox */}
<section class="bg-neutral-200 px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader eyebrow="Studio" title="Tour our office space" />
    <Lightbox client:visible label="Office tour video" videoSrc="/assets/video/office-tour.mp4">
      <span class="group/card relative flex h-[420px] w-full cursor-pointer items-center justify-center overflow-hidden rounded-3xl bg-neutral-800">
        <img
          src="/assets/video/office-tour-poster.jpg"
          alt=""
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <span class="absolute inset-0 bg-neutral-800/30" aria-hidden="true"></span>
        <span class="relative z-10 flex size-16 items-center justify-center rounded-full bg-neutral-100 text-neutral-800 transition-transform duration-300 group-hover/card:scale-110">
          <PlayIcon className="size-6 fill-current" aria-hidden />
        </span>
      </span>
    </Lightbox>
  </div>
</section>

<ProcessTabs variant="v3" />
<QuoteCta />
<TestimonialsSection title="Trusted by 10k+ happy clients worldwide" />

{/* Follow our work — image marquee */}
<section class="overflow-hidden px-0 py-24">
  <div class="mx-auto max-w-[1228px] px-6">
    <SectionHeader eyebrow="Social" title="Follow our work" />
  </div>
  <Marquee duration={35} pauseOnHover>
    {followImages.map((src, i) => (
      <img src={src} alt={`Archipro work ${i + 1}`} loading="lazy" class="h-64 w-80 rounded-2xl object-cover" />
    ))}
  </Marquee>
</section>

<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader eyebrow="Blog" title="Read our latest articles" linkHref="/blog-pages/blog-v3" linkLabel="All articles" />
    <PostsGrid limit={3} />
  </div>
</section>
