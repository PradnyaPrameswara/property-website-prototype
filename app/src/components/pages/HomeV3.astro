---
/**
 * HomeV3 composition — mirrors home-pages/home-v3.html section order:
 * background-video hero → From concept to completion → Tour our office
 * (lightbox) → process tabs → quote CTA → testimonials → Follow our work
 * (marquee) → latest articles.
 * Hero video + office-tour lightbox localized in Phase 5 (/assets/video/).
 */
import SourceSocialSlider from "@/components/sections/SourceSocialSlider.astro";
import SubscribeForm from "@/components/islands/SubscribeForm";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import SourceServiceTabs from "@/components/sections/SourceServiceTabs.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";
import SiteButton from "@/components/site/SiteButton.astro";
import ProcessTabs from "@/components/sections/ProcessTabs.astro";

import Slider from "@/components/site/Slider.astro";

const officeProjects = [
  { slug: "house-architecture-design-in-los-angeles-ca", title: "House architecture design in Los Angeles, CA", image: "69320cff5d1a2607af7c41d7_house-architecture-design-v1-featured-image-archipro-webflow-template.jpg" },
  { slug: "house-architecture-design-in-los-angeles-ca-2", title: "House architecture design in Los Angeles, CA", image: "69320d1b06f609b186057063_house-architecture-design-v2-featured-image-archipro-webflow-template.jpg" },
  { slug: "house-architecture-design-in-los-angeles-ca-3", title: "House architecture design in Los Angeles, CA", image: "69320d3d013ce0bc7c4eff46_house-architecture-design-v3-featured-image-archipro-webflow-template.jpg" },
  { slug: "interior-design-in-san-francisco-california", title: "Interior design in San Francisco, California", image: "69320d6778b1408e9a62b501_interior-design-in-san-francisco-featured-image-archipro-webflow-template.jpg" },
];

---

{/* Original Home V3: photographic card with responsive email CTA. */}
<section class="relative isolate mx-4 mt-4 min-h-[426px] overflow-hidden rounded-3xl bg-neutral-800 sm:mx-6 sm:min-h-[600px] lg:min-h-[770px]">
  <img
    src="/assets/img/688b9d50b83ea2f28adb8d92_modern-mountain-house-archipro-webflow-template.jpg"
    alt="Modern mountain house with exterior deck"
    width="2800"
    height="1576"
    fetchpriority="high"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-neutral-800/35 via-neutral-800/10 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex min-h-[426px] max-w-[1228px] items-end px-5 pb-10 pt-36 sm:min-h-[600px] sm:px-10 lg:min-h-[770px] lg:pb-32">
    <div class="w-full max-w-[626px]">
      <h1 class="max-w-[16ch] text-[clamp(2rem,3.8vw,4.8rem)] lg:max-w-[22ch] lg:text-[clamp(2rem,3.5vw,3.8rem)] leading-[1.08] font-medium tracking-tightest text-neutral-100">
        <span class="lg:block">Crafting spaces with</span> <span class="lg:block">purpose and personality</span>
      </h1>
      <div class="mt-5 max-w-[402px]">
        <SubscribeForm client:load variant="hero" />
      </div>
    </div>
  </div>
</section>

<SourceServiceTabs />

{/* The original Home V3 office section is a four-project portfolio slider. */}
<section class="bg-neutral-200 px-6 py-24" aria-labelledby="office-projects-heading">
  <div class="mx-auto max-w-[1228px]">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-[440px]">
        <h2 id="office-projects-heading" class="mb-4 text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">Tour our office space</h2>
        <p class="leading-[1.6] text-neutral-600">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.</p>
      </div>
      <a href="/contact-pages/contact-v1" class="inline-flex rounded-full bg-neutral-800 px-6 py-3 text-sm font-medium text-neutral-100 transition-colors hover:bg-brand-primary">Get in touch</a>
    </div>
    <Slider label="Browse featured architecture and interior projects">
      {officeProjects.map((project) => (
        <a href={"/portfolio/" + project.slug} class="group grid w-[min(85vw,1060px)] shrink-0 snap-start items-center gap-8 overflow-hidden rounded-3xl bg-neutral-100 p-5 text-neutral-800 no-underline md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:p-8">
          <div class="aspect-[710/428] min-w-0 overflow-hidden rounded-2xl bg-neutral-200">
            <img
              src={"/assets/img/" + project.image}
              alt={project.title}
              width="710"
              height="428"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div>
            <h3 class="mb-5 text-2xl font-medium leading-[1.2] tracking-tightest text-neutral-800 sm:text-3xl">{project.title}</h3>
            <p class="mb-6 leading-[1.6] text-neutral-600">Architecture and interior design projects from the Archipro portfolio.</p>
            <span class="inline-flex rounded-full border border-neutral-800 px-5 py-2.5 text-sm font-medium transition-colors group-hover:bg-neutral-800 group-hover:text-neutral-100">View project</span>
          </div>
        </a>
      ))}
    </Slider>
  </div>
</section>

<ProcessTabs variant="v3" />

{/* Home V3's dark photo-backed inquiry band from the original export. */}
<section class="relative isolate overflow-hidden bg-neutral-800 px-6 py-24 sm:py-32" aria-labelledby="home-v3-inquiry">
  <img
    src="/assets/img/688bb709d55545ae80fca6b9_minimalist-beige-sofa-setup-archipro-webflow-template.png"
    alt=""
    width="1680"
    height="452"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-neutral-800/90 via-neutral-800/70 to-neutral-800/10"></div>
  <div class="relative z-10 mx-auto max-w-[1228px]">
    <div class="max-w-[450px]">
      <h2 id="home-v3-inquiry" class="mb-5 text-4xl font-medium leading-[1.1] tracking-tightest text-neutral-100 sm:text-5xl">Let’s work together. Get a quote today.</h2>
      <p class="mb-7 max-w-[392px] leading-[1.6] text-neutral-200">Lorem ipsum dolor sit amet consectetur sit ultrices rhoncus mi commodo dis nullam feugiat nibh mi duis suspendisse.</p>
      <SiteButton href="/contact-pages/contact-v1" label="Get in touch" variant="light" />
    </div>
  </div>
</section>

{/* Original trust collage: an image testimonial, two statistics and a quote card. */}
<section class="px-6 py-24" aria-labelledby="home-v3-trust">
  <div class="mx-auto max-w-[1228px]">
    <div class="mx-auto mb-12 max-w-[470px] text-center">
      <h2 id="home-v3-trust" class="mb-5 text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">Trusted by 10k+ happy clients worldwide</h2>
      <p class="leading-[1.6] text-neutral-600">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <a href="/contact-pages/contact-v1" class="group relative flex min-h-[400px] flex-col justify-end overflow-hidden rounded-3xl bg-neutral-200 p-7 text-neutral-100 no-underline sm:p-10">
        <img src="/assets/img/688bbda917c91ae1c476a15e_neutral-toned-room-archipro-webflow-template.jpg" alt="Neutral-toned contemporary interior" width="1424" height="796" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
        <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-neutral-800/90 via-neutral-800/35 to-transparent"></span>
        <span class="relative z-10">
          <h3 class="mb-5 max-w-[512px] text-3xl font-medium leading-[1.15] tracking-tightest text-neutral-100">From concept to build, every step was smooth and thoughtful.</h3>
          <span class="text-sm text-neutral-100">John Carter · VP of Design at Converra</span>
        </span>
      </a>
      <div class="flex min-h-[330px] flex-col justify-between rounded-3xl bg-neutral-800 p-7 text-neutral-100 sm:p-10">
        <div class="text-6xl font-medium tracking-tightest sm:text-7xl">80+</div>
        <div>
          <p class="mb-3 text-2xl font-medium">Clients across sectors</p>
          <p class="leading-[1.6] text-neutral-200">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla.</p>
        </div>
      </div>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
      <div class="flex min-h-[310px] flex-col justify-between rounded-3xl bg-brand-secondary-200 p-7 text-neutral-800 sm:p-10">
        <div class="text-6xl font-medium tracking-tightest sm:text-7xl">340+</div>
        <div>
          <p class="mb-3 text-2xl font-medium">Clients across sectors</p>
          <p class="leading-[1.6] text-neutral-600">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla.</p>
        </div>
      </div>
      <div class="flex min-h-[310px] flex-col justify-between rounded-3xl bg-neutral-100 p-7 sm:p-10">
        <p class="max-w-[560px] text-2xl font-medium leading-[1.3] tracking-tightest text-neutral-800 sm:text-3xl">Remarkable service, thoughtful process, and a final result that speaks for itself—refined, timeless, and functional.</p>
        <p class="mt-7 text-sm text-neutral-600">John Carter · VP of Design at Converra</p>
      </div>
    </div>
  </div>
</section>

{/* Source Home V3: the same three verified social cards as Contact V2. */}
<section class="overflow-hidden px-6 py-24" aria-labelledby="home-v3-follow">
  <div class="mx-auto grid max-w-[1228px] items-center gap-8 lg:grid-cols-[minmax(0,0.44fr)_minmax(0,1fr)] lg:gap-14">
    <div>
      <h2 id="home-v3-follow" class="mb-5 text-4xl font-medium tracking-tightest text-neutral-800 sm:text-5xl">Follow our work</h2>
      <p class="mb-6 max-w-[310px] leading-[1.6] text-neutral-600">
        Lorem ipsum dolor sit amet consectetur adipiscing id viverra quis viverra tellus nunc at turpis amet nulla pellentesque pharetra.
      </p>
      <a href="https://www.instagram.com/archipro" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-brand-primary px-6 py-3 text-base font-medium text-neutral-100 hover:bg-neutral-800">@archipro</a>
    </div>
    <SourceSocialSlider />
  </div>
</section>

<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader eyebrow="Blog" title="Read our latest articles" linkHref="/blog-pages/blog-v3" linkLabel="All articles" />
    <PostsGrid limit={3} />
  </div>
</section>
