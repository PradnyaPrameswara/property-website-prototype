---
/**
 * HomeV1 composition — mirrors home-pages/home-v1.html section order:
 * hero → logo marquee → From concept to completion (services) →
 * Inside the firm (about teaser) → Selected works (portfolio) →
 * quote CTA → process tabs → testimonials → latest articles.
 * Images: localized to /assets/img/ in Phase 5.
 */
import SiteButton from "@/components/site/SiteButton.astro";
import Marquee from "@/components/site/Marquee.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import SourceServiceCard from "@/components/sections/SourceServiceCard.astro";
import SourcePortfolioTabs from "@/components/sections/SourcePortfolioTabs.astro";
import PostsGrid from "@/components/sections/PostsGrid.astro";
import HomeV1Testimonials from "@/components/sections/HomeV1Testimonials.astro";
import ProcessCards from "@/components/sections/ProcessCards.astro";


const heroImage = "/assets/img/68894269d79943dcb4fbee77_designing-places-archipro-webflow-template.png";

const heroOverlay = "/assets/img/688942340e598afe2c3207bf_hero-linear-bg-archipro-webflow-template.png";

const studioImage = "/assets/img/688a5b011779274c81245d83_inside-firm-archipro-webflow-template.jpg";

const partners = [
  { name: "Vireon", file: "6883d9dcf978a79188aaafeb_vireon-logo-company-archipro-webflow-template.svg", width: 124 },
  { name: "Linkora", file: "6883d9dc8be2d0a7690019e7_linkora-logo-company-archipro-webflow-template.svg", width: 145 },
  { name: "Converra", file: "6883d9dc74f4793a5b09b481_converra-logo-company-archipro-webflow-template.svg", width: 156 },
  { name: "Nexora", file: "6883d9dc0175aafefd64b4f6_nexora-logo-company-archipro-webflow-template.svg", width: 130 },
  { name: "Syncell", file: "6883d9dc31f0406c374e6c3f_syncell-logo-company-archipro-webflow-template.svg", width: 139 },
  { name: "Socium", file: "6883d9dc48a8579a5efd16f3_socium-logo-company-archipro-webflow-template.svg", width: 148 },
  { name: "Bridgr", file: "6883d9dc4717347feac9ab9b_bridgr-logo-company-archipro-webflow-template.svg", width: 148 },
  { name: "Netspire", file: "6883d9dd971331992c54bd48_netspire-logo-company-archipro-webflow-template.svg", width: 148 },
]; 

const serviceDescription = "Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.";
---

{/* Original Home V1 hero: centered heading over the local house and gradient assets. */}
<section class="relative isolate mx-4 mt-4 min-h-[450px] overflow-hidden rounded-3xl bg-brand-secondary-200 sm:mx-6 sm:min-h-[660px] lg:min-h-[770px]" aria-labelledby="home-v1-title">
  <img src={heroOverlay} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover" />
  <img
    src={heroImage}
    alt="Minimalist architecture exterior"
    width="1584"
    height="900"
    fetchpriority="high"
    loading="eager"
    class="pointer-events-none absolute inset-0 h-full w-full object-contain object-bottom lg:translate-y-24"
  />
  <div class="relative z-10 mx-auto flex max-w-[730px] flex-col items-center px-6 pt-36 text-center sm:pt-36 lg:pt-36">
    <h1 id="home-v1-title" class="text-[clamp(2rem,4vw,3.8rem)] leading-[1.05] font-medium tracking-tightest text-neutral-800">
      <span class="lg:block">Designing places that feel</span> <span class="lg:block">as good as they look</span>
    </h1>
    <div class="mt-4 sm:mt-7">
      <SiteButton href="/contact-pages/contact-v1" label="Get in touch" class="max-sm:px-5 max-sm:py-2" />
    </div>
  </div>
</section>

{/* Original partner logos, rather than plain-text substitutes. */}
<section class="overflow-hidden px-4 py-12 sm:px-6" aria-label="Our partners">
  <div class="mx-auto max-w-[1228px]">
    <Marquee duration={35} pauseOnHover>
      {partners.map((partner) => (
        <img
          src={"/assets/brand/partners/" + partner.file}
          alt={partner.name}
          width={partner.width}
          height="40"
          loading="lazy"
          class="h-10 w-auto max-w-none object-contain"
        />
      ))}
    </Marquee>
  </div>
</section>

{/* Source-matched service cards: title first on mobile, first image left on desktop. */}
<section class="px-6 py-20 lg:py-24">
  <div class="mx-auto max-w-[1228px]">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,0.85fr)] lg:gap-14">
      <SourceServiceCard
        href="/service-pages/services"
        title="Exterior design"
        image="/assets/img/688a50ccb8be7acefbef0b1b_exterior-design-archipro-webflow-template.png"
        alt="Outdoor seating and natural wood exterior design"
        description={serviceDescription}
        class="order-2 lg:order-1"
      />
      <div class="order-1 flex flex-col justify-center lg:order-2">
        <h2 class="mb-4 text-2xl leading-[1.08] font-medium tracking-tightest text-neutral-800 sm:text-4xl lg:text-5xl">
          From concept to completion
        </h2>
        <p class="mb-6 max-w-[420px] leading-[1.6] text-neutral-600">
          {serviceDescription}
        </p>
        <a href="/service-pages/services" class="inline-flex w-fit rounded-full bg-neutral-800 px-6 py-3 text-sm font-medium text-neutral-100 transition-colors hover:bg-brand-primary">
          Browse all services
        </a>
      </div>
    </div>
    <div class="mt-6 grid items-start gap-6 sm:grid-cols-2">
      <SourceServiceCard
        href="/service-pages/services"
        title="Decoration"
        image="/assets/img/688a50cbfbe8559898958990_construction-archipro-webflow-template.png"
        alt="Decorative ceramic vases and candles"
        description={serviceDescription}
      />
      <SourceServiceCard
        href="/service-pages/services"
        title="Construction"
        image="/assets/img/688a50cc8c4226dcdd1fe747_decoration-archipro-webflow-template.png"
        alt="Contemporary residential architecture"
        description={serviceDescription}
        tall
      />
    </div>
  </div>
</section>

{/* Original studio photo background, replacing the previous empty placeholder. */}
<section class="relative isolate mx-4 overflow-hidden rounded-3xl bg-neutral-800 sm:mx-6">
  <img src={studioImage} alt="" width="2800" height="1308" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-r from-neutral-800/90 via-neutral-800/45 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-[1228px] px-6 py-24 sm:py-36 lg:py-48">
    <div class="max-w-[350px]">
      <h2 class="mb-5 text-4xl leading-[1.08] font-medium tracking-tightest text-neutral-100 sm:text-5xl">Inside the firm</h2>
      <p class="mb-8 text-lg leading-[1.55] text-neutral-200">
        Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.
      </p>
      <SiteButton href="/contact-pages/contact-v1" label="Get in touch" variant="light" />
    </div>
  </div>
</section>

<SourcePortfolioTabs />

{/* Home V1's photo-backed CTA, not the generic solid-color reusable band. */}
<section class="relative isolate overflow-hidden bg-brand-secondary-200 px-6 pt-24 pb-0" aria-labelledby="home-v1-quote-title">
  <div class="relative z-10 mx-auto max-w-[1228px]">
    <div class="mx-auto max-w-[580px] text-center">
      <h2 id="home-v1-quote-title" class="mb-5 text-4xl font-medium leading-[1.1] tracking-tightest text-neutral-800 sm:text-5xl">Let’s work together. Get a quote today.</h2>
      <p class="mx-auto mb-7 max-w-[426px] leading-[1.6] text-neutral-600">Lorem ipsum dolor sit amet consectetur faucibus nunc habitasse aliquam vestibulum auctor fringilla risus consequat est semper.</p>
      <div class="flex justify-center">
        <SiteButton href="/contact-pages/contact-v1" label="Get in touch" />
      </div>
    </div>
    <img
      src="/assets/img/688a6e143964a243bff7c382_modern-lounge-setup-archipro-webflow-template.png"
      alt="Architectural lounge with contemporary furniture"
      width="2160"
      height="1005"
      loading="lazy"
      class="mx-auto mt-12 w-full object-contain object-bottom"
    />
  </div>
</section>

<ProcessCards />
<HomeV1Testimonials />

{/* Latest articles */}
<section class="px-6 py-24">
  <div class="mx-auto max-w-[1228px]">
    <SectionHeader
      eyebrow="Blog"
      title="Read our latest articles"
      linkHref="/blog-pages/blog-v1"
      linkLabel="All articles"
    />
    <PostsGrid limit={3} />
  </div>
</section>
